# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=booking_platform
MYSQL_USER=booking_app
MYSQL_PASSWORD=change_me_app
MYSQL_PORT=3306

# ---- Backend ----
DB_HOST=mysql
DB_PORT=3306
DB_USER=booking_app
DB_PASSWORD=change_me_app
DB_NAME=booking_platform
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES=7d
BACKEND_PORT=3000
UPLOADS_DIR=/app/uploads
CORS_ORIGIN=http://localhost

# First Super Admin, seeded automatically on backend startup if it doesn't exist yet
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=change_me_admin_password

# ---- Mail (booking confirmations) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Booking Platform <no-reply@example.com>"

# ---- Payments (Stripe test mode) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- Nginx ----
HTTP_PORT=80
HTTPS_PORT=443

# ---- Image registry (build on your dev machine, push here, VM just pulls) ----
# Format: <region>-docker.pkg.dev/<GCP_PROJECT_ID>/<REPOSITORY_NAME>
# Same value must be set in .env on BOTH your local machine (for build+push) and the VM
# (for pull) — see the Artifact Registry setup steps.
ARTIFACT_REGISTRY=asia-southeast1-docker.pkg.dev/change-me-project-id/booking-platform
